# FastAPI Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Application Settings
APP_NAME=Schema Rag
VERSION=1.0.0

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:Rohit123@localhost:5432/schema_rag

# NVIDIA API Configuration
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_SQL_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_FORMATTER_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NVIDIA_EMBEDDING_DIM=2048
NVIDIA_RERANKER_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/reranking
NVIDIA_RERANKER_MODEL=nv-rerank-qa-mistral-4b:1

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=schema_metadata
